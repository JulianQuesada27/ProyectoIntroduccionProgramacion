package com.mycompany.Biblioteca;
import javax.swing.JOptionPane;
/**
 *
 * @author Joshua
 */
public class Consultas {
    

    // ==================== CONSULTAR TODOS LOS LIBROS ====================
    public static void consultarLibros(Libro[] libros, int cantidadLibros) {
        if (cantidadLibros == 0) {
            JOptionPane.showMessageDialog(null, "No hay libros registrados.");
            return;
        }

        String resultado = "===== CONSULTA DE LIBROS =====\n\n";
        for (int i = 0; i < cantidadLibros; i++) {
            resultado += "Código: " + libros[i].getCodigo() + "\n";
            resultado += "Título: " + libros[i].getTitulo() + "\n";
            resultado += "Autor: " + libros[i].getAutor() + "\n";
            resultado += "Disponible: " + (libros[i].isDisponible() ? "Sí" : "No") + "\n";
            resultado += "-----------------------------\n";
        }
        JOptionPane.showMessageDialog(null, resultado);
    }

    // ==================== CONSULTAR TODOS LOS USUARIOS ====================
    public static void consultarUsuarios(Usuario[] usuarios, int cantidadUsuarios) {
        if (cantidadUsuarios == 0) {
            JOptionPane.showMessageDialog(null, "No hay usuarios registrados.");
            return;
        }

        String resultado = "===== CONSULTA DE USUARIOS =====\n\n";
        for (int i = 0; i < cantidadUsuarios; i++) {
            resultado += "ID: " + usuarios[i].getId() + "\n";
            resultado += "Nombre: " + usuarios[i].getNombre() + "\n";
            resultado += "Teléfono: " + usuarios[i].getTelefono() + "\n";
            resultado += "-----------------------------\n";
        }
        JOptionPane.showMessageDialog(null, resultado);
    }

    // ==================== LIBROS DISPONIBLES ====================
    public static void consultarLibrosDisponibles(Libro[] libros, int cantidadLibros) {
        String resultado = "===== LIBROS DISPONIBLES =====\n\n";
        boolean encontrado = false;

        for (int i = 0; i < cantidadLibros; i++) {
            if (libros[i].isDisponible()) {
                resultado += "Código: " + libros[i].getCodigo() + "\n";
                resultado += "Título: " + libros[i].getTitulo() + "\n";
                resultado += "Autor: " + libros[i].getAutor() + "\n";
                resultado += "-----------------------------\n";
                encontrado = true;
            }
        }

        if (!encontrado) {
            resultado = "No hay libros disponibles.";
        }
        JOptionPane.showMessageDialog(null, resultado);
    }

    // ==================== LIBROS PRESTADOS ====================
    public static void consultarLibrosPrestados(Libro[] libros, int cantidadLibros) {
        String resultado = "===== LIBROS PRESTADOS =====\n\n";
        boolean encontrado = false;

        for (int i = 0; i < cantidadLibros; i++) {
            if (!libros[i].isDisponible()) {
                resultado += "Código: " + libros[i].getCodigo() + "\n";
                resultado += "Título: " + libros[i].getTitulo() + "\n";
                resultado += "Autor: " + libros[i].getAutor() + "\n";
                resultado += "-----------------------------\n";
                encontrado = true;
            }
        }

        if (!encontrado) {
            resultado = "No hay libros prestados.";
        }
        JOptionPane.showMessageDialog(null, resultado);
    }

    // ==================== CONSULTAR PRÉSTAMOS ====================
    public static void consultarPrestamos(Prestamo[] prestamos, int cantidadPrestamos) {
        if (cantidadPrestamos == 0) {
            JOptionPane.showMessageDialog(null, "No hay préstamos registrados.");
            return;
        }

        String resultado = "===== CONSULTA DE PRÉSTAMOS =====\n\n";
        for (int i = 0; i < cantidadPrestamos; i++) {
            resultado += "Código Libro: " + prestamos[i].getCodigoLibro() + "\n";
            resultado += "ID Usuario: " + prestamos[i].getIdUsuario() + "\n";
            resultado += "Fecha Préstamo: " + prestamos[i].getFechaPrestamo() + "\n";
            resultado += "Fecha Entrega: " + prestamos[i].getFechaEntrega() + "\n";
            resultado += "-----------------------------\n";
        }
        JOptionPane.showMessageDialog(null, resultado);
    }

    // ==================== CONSULTAR DEVOLUCIONES ====================
    public static void consultarDevoluciones(Devolucion[] devoluciones, int cantidadDevoluciones) {
        if (cantidadDevoluciones == 0) {
            JOptionPane.showMessageDialog(null, "No hay devoluciones registradas.");
            return;
        }

        String resultado = "===== HISTORIAL DE DEVOLUCIONES =====\n\n";
        for (int i = 0; i < cantidadDevoluciones; i++) {
            resultado += "Código Libro: " + devoluciones[i].getCodigoLibro() + "\n";
            resultado += "ID Usuario: " + devoluciones[i].getIdUsuario() + "\n";
            resultado += "Fecha Devolución: " + devoluciones[i].getFechaDevolucion() + "\n";
            resultado += "-----------------------------\n";
        }
        JOptionPane.showMessageDialog(null, resultado);
    }

    // ==================== MENÚ DE CONSULTAS ====================
    public static void menuConsultas(Libro[] libros, int cantidadLibros,
                                      Usuario[] usuarios, int cantidadUsuarios,
                                      Prestamo[] prestamos, int cantidadPrestamos,
                                      Devolucion[] devoluciones, int cantidadDevoluciones) {
        String opcionTexto;
        int opcion;
        do {
            opcionTexto = JOptionPane.showInputDialog(
                "=== MÓDULO DE CONSULTAS ===\n" +
                "1. Consultar todos los libros\n" +
                "2. Consultar todos los usuarios\n" +
                "3. Ver libros disponibles\n" +
                "4. Ver libros prestados\n" +
                "5. Consultar préstamos\n" +
                "6. Historial de devoluciones\n" +
                "7. Regresar al menú principal\n\n" +
                "Seleccione una opción:"
            );

            if (opcionTexto == null) {
                opcion = 7;
            } else {
                opcion = Integer.parseInt(opcionTexto);
            }

            switch (opcion) {
                case 1: consultarLibros(libros, cantidadLibros); break;
                case 2: consultarUsuarios(usuarios, cantidadUsuarios); break;
                case 3: consultarLibrosDisponibles(libros, cantidadLibros); break;
                case 4: consultarLibrosPrestados(libros, cantidadLibros); break;
                case 5: consultarPrestamos(prestamos, cantidadPrestamos); break;
                case 6: consultarDevoluciones(devoluciones, cantidadDevoluciones); break;
                case 7: JOptionPane.showMessageDialog(null, "Volviendo al menú principal..."); break;
                default: JOptionPane.showMessageDialog(null, "Opción no válida");
            }

        } while (opcion != 7);
    }
}
    

